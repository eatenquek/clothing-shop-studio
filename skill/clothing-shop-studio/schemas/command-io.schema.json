{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.clothing-shop-studio/command-io.schema.json",
  "title": "Clothing Shop Studio command response",
  "description": "Every command reads one JSON object (stdin or --input) and prints one response. Exit codes: 0 success, 2 validation error, 3 unsafe path, 4 storage error, 5 internal error.",
  "type": "object",
  "required": ["ok", "command", "schema_version"],
  "properties": {
    "ok": {"type": "boolean"},
    "command": {
      "enum": [
        "create_project",
        "resume_project",
        "record_answer",
        "generate_options",
        "approve_design",
        "register_file",
        "validate",
        "export_production_pack",
        "status",
        "command_error",
        "render_options",
        "extract",
        "create_models",
        "try_on",
        "create_listing",
        "migrate_layout"
      ]
    },
    "schema_version": {"const": 1},
    "data": {"type": "object"},
    "error": {
      "type": "object",
      "required": ["code", "message", "recovery"],
      "properties": {
        "code": {"enum": ["validation_error", "migration_required", "unsafe_path", "storage_error", "internal_error"]},
        "message": {"type": "string"},
        "recovery": {"type": "string"},
        "field": {"type": "string"},
        "path": {"type": "string"},
        "details": {
          "type": "array",
          "description": "Structured findings, for example export blockers, each with a stable code.",
          "items": {"type": "object", "required": ["code", "message"]}
        }
      }
    }
  },
  "oneOf": [
    {"properties": {"ok": {"const": true}}, "required": ["data"]},
    {"properties": {"ok": {"const": false}}, "required": ["error"]}
  ]
}
